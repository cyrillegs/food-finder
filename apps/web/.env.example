NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# This app's own public origin. Used only to turn the Open Graph image path
# into the absolute URL that link-preview scrapers require - the app itself
# works without it. Must be set at BUILD time for a Docker/production build
# (NEXT_PUBLIC_* vars are inlined by `next build`), which is why the web
# Dockerfile takes it as a build arg.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
