# Matches the credentials + port mapping in ../../docker-compose.yml
DATABASE_URL="mysql://food_finder:food_finder@localhost:3307/food_finder"

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Stripe - left blank on purpose. Creating a real Price/Product requires the
# Stripe dashboard or an API key, which is a manual follow-up outside Module 0.
# Local webhook testing (Module 2) requires the Stripe CLI installed and
# `stripe login` run once beforehand: https://docs.stripe.com/stripe-cli
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
