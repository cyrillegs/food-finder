// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// The CLI reads the connection URL from prisma.config.ts (Prisma 7 no longer
// supports `url = env(...)` here). See apps/api/.env.example for DATABASE_URL.
datasource db {
  provider = "mysql"
}

// Using the classic (deprecated but still supported) prisma-client-js
// generator so the client is importable as `@prisma/client`, matching the
// module's dependency list, rather than the newer `prisma-client` generator
// (ESM-only, custom output path). Note that in Prisma 7 BOTH generators
// require a driver adapter at runtime for MySQL - see src/shared/prisma.ts,
// which passes DATABASE_URL straight to @prisma/adapter-mariadb as a
// connection string (no discrete host/user/password fields needed).
generator client {
  provider = "prisma-client-js"
}

// Replaces DemoUser (Modules 0-5's single hardcoded row) with real,
// per-visitor accounts - see apps/api/src/modules/auth for the module that
// reads/writes this. Shape deliberately mirrors DemoUser's own
// (stripeCustomerId/stripeSubscriptionId/subscriptionStatus) plus
// passwordHash, so Subscriptions' existing field-level logic barely had to
// change - only the "which row" lookup changed, from a hardcoded id to the
// authenticated request's user.
model User {
  id                   Int      @id @default(autoincrement())
  email                String   @unique
  passwordHash         String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String   @default("inactive")
  createdAt            DateTime @default(now())
}

// DB-backed session storage (see apps/api/src/modules/auth/auth.service.ts
// for the "why a session table instead of a JWT" reasoning). `tokenHash` is
// a SHA-256 hash of the random session token the cookie actually carries -
// the raw token is never persisted, the same defense-in-depth principle as
// not storing plaintext passwords: a DB read/leak alone can't be replayed as
// a valid session cookie. No @relation to User (matching this project's
// existing style - see RecentSearch below, which never had one back to
// DemoUser either) - `userId` is just a plain scoping column with an index.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RecentSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  query     String
  createdAt DateTime @default(now())

  @@index([userId])
}
